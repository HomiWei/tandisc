# Copy to backend/.env for local overrides. Never commit .env or real secrets.
# Empty values are placeholders. The process boots without any of the secret fields.

APP_PORT=8080
APP_ENV=local

# PostgreSQL URL for staging. Leave empty to use the local SQLite file backend/data/tandisc.db.
DATABASE_URL=

# Optional. Not read at boot and not required to serve product lists or rankings.
GITHUB_TOKEN=

# POST /api/v1/ask calls a model only when all three are set. Otherwise it returns 503.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

APP_TIMEZONE=Asia/Shanghai
